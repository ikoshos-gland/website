@article{zhengFastImagingMillimeterscale2024,
  title = {Fast Imaging of Millimeter-Scale Areas with Beam Deflection Transmission Electron Microscopy},
  author = {Zheng, Zhihao and Own, Christopher S. and Wanner, Adrian A. and Koene, Randal A. and Hammerschmith, Eric W. and Silversmith, William M. and Kemnitz, Nico and Lu, Ran and Tank, David W. and Seung, H. Sebastian},
  year = 2024,
  month = aug,
  journal = {Nature Communications},
  volume = {15},
  number = {1},
  pages = {6860},
  publisher = {Nature Publishing Group},
  issn = {2041-1723},
  doi = {10.1038/s41467-024-50846-4},
  urldate = {2026-05-24},
  abstract = {Serial section transmission electron microscopy (TEM) has proven to be one of the leading methods for millimeter-scale 3D imaging of brain tissues at nanoscale resolution. It is important to further improve imaging efficiency to acquire larger and more brain volumes. We report here a threefold increase in the speed of TEM by using a beam deflecting mechanism to enable highly efficient acquisition of multiple image tiles (nine) for each motion of the mechanical stage. For millimeter-scale areas, the duty cycle of imaging doubles to more than 30\%, yielding a net average imaging rate of 0.3 gigapixels per second. If fully utilized, an array of four beam deflection TEMs should be capable of imaging a dataset of cubic millimeter scale in five weeks.},
  copyright = {2024 The Author(s)},
  langid = {english},
  keywords = {3-D reconstruction,Neuroscience,Transmission electron microscopy}
}

@article{zhuangLandscapeExpansionMicroscopy2025,
  title = {Landscape {{Expansion Microscopy Reveals Interactions}} between {{Membrane}} and {{Phase-Separated Organelles}}},
  author = {Zhuang, Yinyin and Zhang, Zhao and Dai, Zhipeng and Shi, Xiaoyu},
  year = 2025,
  month = dec,
  journal = {bioRxiv},
  pages = {2025.12.10.693600},
  issn = {2692-8205},
  doi = {10.64898/2025.12.10.693600},
  urldate = {2026-05-06},
  abstract = {Landscape Expansion Microscopy (land-ExM) is a light microscopy technique that visualizes both lipid and protein ultrastructural context of cells. Achieving this level of detail requires both superresolution and a high signal-to-noise ratio. Although expansion microscopy (ExM) provides superresolution, obtaining high signal-to-noise images of both proteins and lipids remains challenging. Land-ExM overcomes this limitation by using self-retention trifunctional anchors to significantly enhance protein and lipid signals in expanded samples. This improvement enables the accurate visualization of diverse membrane organelles and phase separations, as well as the three-dimensional visualization of their contact sites. As a demonstration, we revealed triple-organellar contact sites among the stress granule, the nuclear tunnel, and the nucleolus. Overall, land-ExM offers a high-contrast superresolution platform that advances our understanding of how cells spatially coordinate interactions between membrane organelles and phase separations., Zhuang et al. introduce land-ExM, a super-resolution approach that simultaneously maps protein and lipid ultrastructure in cells with high contrast. This method visualizes 3D interactions between membrane-bound organelles and phase-separated condensates, uncovering organelle contact sites such as stress granules at nuclear tunnels adjacent to nucleoli.},
  pmcid = {PMC12714020},
  pmid = {41427408}
}

