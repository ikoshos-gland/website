@article{changIterativeExpansionMicroscopy2017,
  title = {Iterative Expansion Microscopy},
  author = {Chang, Jae-Byum and Chen, Fei and Yoon, Young-Gyu and Jung, Erica E. and Babcock, Hazen and Kang, Jeong Seuk and Asano, Shoh and Suk, Ho-Jun and Pak, Nikita and Tillberg, Paul W. and Wassie, Asmamaw and Cai, Dawen and Boyden, Edward S.},
  year = 2017,
  month = jun,
  journal = {Nature methods},
  volume = {14},
  number = {6},
  pages = {593--599},
  issn = {1548-7091},
  doi = {10.1038/nmeth.4261},
  urldate = {2026-05-11},
  abstract = {We recently discovered it was possible to physically magnify preserved biological specimens by embedding them in a densely crosslinked polyelectrolyte gel, anchoring key labels or biomolecules to the gel, mechanically homogenizing the specimen, and then swelling the gel-specimen composite by \textasciitilde 4.5x in linear dimension, a process we call expansion microscopy (ExM). Here we describe iterative expansion microscopy (iExM), in which a sample is expanded, then a second swellable polymer mesh is formed in the space newly opened up by the first expansion, and finally the sample is expanded again. iExM expands biological specimens \textasciitilde 4.5 \texttimes{} 4.5 or \textasciitilde 20x, and enables \textasciitilde 25 nm resolution imaging of cells and tissues on conventional microscopes. We used iExM to visualize synaptic proteins, as well as the detailed architecture of dendritic spines, in mouse brain circuitry.},
  pmcid = {PMC5560071},
  pmid = {28417997}
}

@article{changIterativeExpansionMicroscopy2017a,
  title = {Iterative Expansion Microscopy},
  author = {Chang, Jae-Byum and Chen, Fei and Yoon, Young-Gyu and Jung, Erica E. and Babcock, Hazen and Kang, Jeong Seuk and Asano, Shoh and Suk, Ho-Jun and Pak, Nikita and Tillberg, Paul W. and Wassie, Asmamaw T. and Cai, Dawen and Boyden, Edward S.},
  year = 2017,
  month = jun,
  journal = {Nature Methods},
  volume = {14},
  number = {6},
  pages = {593--599},
  publisher = {Nature Publishing Group},
  issn = {1548-7105},
  doi = {10.1038/nmeth.4261},
  urldate = {2026-05-21},
  abstract = {Iterative expansion microscopy (iExM) is a strategy that achieves high resolution expansion microscopy by expanding samples multiple times. Expanding a sample twice enables {$\sim$}4.5 \texttimes{} 4.5 {$\sim$}20\texttimes{} physical expansion and {$\sim$}25 nm resolution.},
  copyright = {2017 Springer Nature America, Inc.},
  langid = {english},
  keywords = {Fluorescence imaging,Molecular neuroscience}
}

@article{chenExpansionMicroscopy2015,
  title = {Expansion Microscopy},
  author = {Chen, Fei and Tillberg, Paul W. and Boyden, Edward S.},
  year = 2015,
  month = jan,
  journal = {Science},
  volume = {347},
  number = {6221},
  pages = {543--548},
  publisher = {American Association for the Advancement of Science},
  doi = {10.1126/science.1260088},
  urldate = {2026-05-24},
  abstract = {In optical microscopy, fine structural details are resolved by using refraction to magnify images of a specimen. We discovered that by synthesizing a swellable polymer network within a specimen, it can be physically expanded, resulting in physical magnification. By covalently anchoring specific labels located within the specimen directly to the polymer network, labels spaced closer than the optical diffraction limit can be isotropically separated and optically resolved, a process we call expansion microscopy (ExM). Thus, this process can be used to perform scalable superresolution microscopy with diffraction-limited microscopes. We demonstrate ExM with apparent \textasciitilde 70-nanometer lateral resolution in both cultured cells and brain tissue, performing three-color superresolution imaging of \textasciitilde 107 cubic micrometers of the mouse hippocampus with a conventional confocal microscope.}
}

@article{chenNanoscaleImagingRNA2016,
  title = {Nanoscale {{Imaging}} of {{RNA}} with {{Expansion Microscopy}}},
  author = {Chen, Fei and Wassie, Asmamaw T. and Cote, Allison J. and Sinha, Anubhav and Alon, Shahar and Asano, Shoh and Daugharthy, Evan R. and Chang, Jae-Byum and Marblestone, Adam and Church, George M. and Raj, Arjun and Boyden, Edward S.},
