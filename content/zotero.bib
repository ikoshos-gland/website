@article{khajehConnectomicsElectronMicroscopy2025,
  title = {Connectomics beyond Electron Microscopy},
  author = {Khajeh, Ramin and Lee, Wei-Chung Allen},
  year = 2025,
  month = dec,
  journal = {Nature Methods},
