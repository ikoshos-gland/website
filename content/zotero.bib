  langid = {english},
  keywords = {Boats,Book,Chuck,Chunked out,Cut off technique,Cutting board,Dispensing slides,Embedding,Embedding shelf,Face down cryoembedding in well bars,Face down embedding,Face up embedding,Filling the well,Freeze artifact,Freezing griddle,Freezing time,Frozen block cryoembedding,Gouge technique,Handle,Launch pad,Liquids,Membrane rolls,Multiple specimens,On edge embedding,On face embedding,On point embedding,Over-chuck freezing block,Paper embedding,Parallel faces,Plastering technique,Pre-freezing tissue,Precision cryoembedding system,Snap freezing,Specimen stage,Super flat embedding,Well bars,x-y orientation}
