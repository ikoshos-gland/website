@article{bissenExpansionMicroscopyMouse2022,
  title = {Expansion Microscopy of Mouse Brain Organotypic Slice Cultures to Study Protein Distribution},
  author = {Bissen, Diane and Kracht, Maximilian Ken and Foss, Franziska and {Acker-Palmer}, Amparo},
