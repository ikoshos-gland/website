@misc{NextgenerationExpansionMicroscopy,
  title = {Next-Generation Expansion Microscopy: 20\texttimes{} Magnification in One Step},
  shorttitle = {Next-Generation Expansion Microscopy},
  urldate = {2026-05-02},
  abstract = {Expansion microscopy (ExM) has revolutionized biological imaging by enabling nanoscale-resolution visualization on conventional microscopes. Traditional ExM methods have been limited to \textasciitilde 4--10\texttimes{} expansion per step or require iterative processes to achieve higher magnifications (\textasciitilde 15--20\texttimes ). In this webinar, we will introduce 20ExM, a novel single-shot ExM protocol that achieves \textasciitilde 20\texttimes{} expansion in a single step, providing \&lt;20 nm resolution. This innovation simplifies high-resolution imaging while supporting postexpansion biomolecular staining in brain tissue. The discussion will cover the principles of ExM, the advantages of 20ExM over iterative expansion, and its potential applications in neuroscience, cell biology, and beyond.Highlights- Fundamentals of expansion microscopy (ExM) and its impact on high-resolution imaging.- 20ExM: A single-shot expansion protocol achieving \textasciitilde 20\texttimes{} linear expansion.- Post-expansion antibody staining for brain tissue and its implications.- Applications of 20ExM in neuroscience and cell biology and comparison with previous ExM approaches.},
  howpublished = {https://bio-protocol.org/webinar/detail?number=562345227612848131},
  langid = {english}
}

